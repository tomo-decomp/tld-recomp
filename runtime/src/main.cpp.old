// tld_native: the host side of the Tomodachi Life recompilation.
//
//   tld_native --check [--dump DIR]        validate the dump and report what it holds
//   tld_native --dump DIR [--frames N]     open the window and run the frame loop
//
// The game's own code is not in this repository: it is generated from your dump by
// tools/lift (see docs/PLAN.md) and linked in with -DTLD_GAME_LIB.
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>

#include "tld/dump.h"
#include "tld/hle.h"
#include "tld/platform.h"

namespace {

void usage() {
    std::printf(
        "tld_native - Tomodachi Life: Living the Dream, native\n"
        "  --dump DIR     the dump folder holding exefs/ and romfs/ (default: private/tld)\n"
        "  --check        validate the dump, print facts, do not open a window\n"
        "  --frames N     stop after N frames (0 = until the window is closed)\n"
        "  --help\n");
}

}  // namespace

int main(int argc, char** argv) {
    std::string dump_dir = "private/tld";
    bool check = false;
    int frames = 0;

    for (int i = 1; i < argc; ++i) {
        const char* a = argv[i];
        if (!std::strcmp(a, "--dump") && i + 1 < argc) {
            dump_dir = argv[++i];
        } else if (!std::strcmp(a, "--check")) {
            check = true;
        } else if (!std::strcmp(a, "--frames") && i + 1 < argc) {
            frames = std::atoi(argv[++i]);
        } else if (!std::strcmp(a, "--help") || !std::strcmp(a, "-h")) {
            usage();
            return 0;
        } else {
            std::fprintf(stderr, "unknown argument: %s\n", a);
            usage();
            return 2;
        }
    }

    const tld::Dump dump = tld::load_dump(dump_dir);
    tld::register_builtin_services();

    std::printf("%s", tld::describe(dump).c_str());
    std::printf("hle         %zu request handler(s) registered\n", tld::hle().handler_count());

    if (!dump.has_exefs || !dump.main_nso.ok) {
        std::fprintf(stderr,
                     "\nno usable dump at %s.\n"
                     "Build it from your own packages first:\n"
                     "  python tools/tld.py exefs      (ExeFS of the update, or of the base game)\n"
                     "  python tools/tld.py romfs      (RomFS, base with the update applied)\n",
                     dump_dir.c_str());
        return check ? 1 : 3;
    }

    if (check) {
        const tld::Platform p = tld::probe();
        std::printf("video       %s (%s)\n", p.video_ready ? "ready" : "unavailable", p.video_driver.c_str());
        std::printf("graphics    %s\n", p.vulkan_note.c_str());
        std::printf("status      dump OK\n");
        return 0;
    }

    return tld::run_window("Tomodachi Life: Living the Dream (native)", 1280, 720, frames) ? 0 : 4;
}
